<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:UmlWizard.App.Resources"
        xmlns:vm="using:UmlWizard.App.ViewModels"
        x:Class="UmlWizard.App.Views.SplashWindow"
        x:DataType="vm:AboutViewModel"
        Title="{Binding ProductName}"
        Width="440" Height="240"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">
  <!-- Shown while the application starts; App.axaml.cs replaces it with the main window -->
  <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
    <DockPanel Margin="32,28">
      <TextBlock DockPanel.Dock="Bottom" Text="{x:Static res:Strings.Splash_Loading}" Classes="caption" />
      <StackPanel Spacing="18" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border Width="80" Height="80" CornerRadius="12" Padding="8" Background="{DynamicResource LogoBackgroundBrush}">
            <Image Source="/Assets/UmlWizard.png" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding ProductName}" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Version, StringFormat={x:Static res:Strings.About_Version}}" Classes="caption" FontSize="12" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
