<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:UmlWizard.App.Resources"
             xmlns:dvm="using:UmlWizard.App.ViewModels.Dialogs"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="UmlWizard.App.Views.Dialogs.ExportPngView"
             x:DataType="dvm:ExportPngViewModel"
             Width="480">
  <!-- The warning keeps its space while hidden, so the dialog does not change size when it appears -->
  <UserControl.Styles>
    <Style Selector="mi|MaterialIcon#FileExistsIcon, TextBlock#FileExistsText">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="mi|MaterialIcon#FileExistsIcon.shown, TextBlock#FileExistsText.shown">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="12">
    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,10,Auto,Auto">
      <TextBlock Classes="caption" Text="{x:Static res:Strings.Dialog_Export_OutputFolder}" VerticalAlignment="Center" />
      <DockPanel Grid.Column="1">
        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="{x:Static res:Strings.Button_Browse}" Margin="6,0,0,0"
                Command="{Binding BrowseFolderCommand}" ToolTip.Tip="{x:Static res:Strings.Dialog_Export_Browse_Tip}" />
        <TextBox x:Name="OutputFolderBox" Text="{Binding OutputFolder}" Watermark="{x:Static res:Strings.Dialog_Export_OutputFolder_Hint}"
                 LostFocus="OnFieldLostFocus" />
      </DockPanel>

      <TextBlock Classes="caption" Grid.Row="2" Text="{x:Static res:Strings.Dialog_Export_FileName}" VerticalAlignment="Center" />
      <DockPanel Grid.Row="2" Grid.Column="1">
        <mi:MaterialIcon x:Name="FileExistsIcon" DockPanel.Dock="Right" Kind="AlertOutline" Width="20" Height="20"
                         Foreground="{DynamicResource ErrorForegroundBrush}" Margin="6,0,0,0" Classes.shown="{Binding FileExists}" IsHitTestVisible="{Binding FileExists}"
                         ToolTip.Tip="{x:Static res:Strings.Dialog_Export_FileExists_Tip}" />
        <TextBox x:Name="FileNameBox" Text="{Binding FileName}" Watermark="{x:Static res:Strings.Dialog_Export_FileName_Hint}" LostFocus="OnFieldLostFocus" />
      </DockPanel>
      <TextBlock Classes="caption" x:Name="FileExistsText" Grid.Row="3" Grid.Column="1" Text="{x:Static res:Strings.Dialog_Export_FileExists}" FontSize="11"
                 Foreground="{DynamicResource ErrorForegroundBrush}" Margin="2,3,0,0" Classes.shown="{Binding FileExists}" />
    </Grid>

    <StackPanel Spacing="4">
      <CheckBox x:Name="TransparentBackground" Content="{x:Static res:Strings.Dialog_Export_Transparent}" IsChecked="{Binding TransparentBackground}" />
      <TextBlock Classes="caption" TextWrapping="Wrap" Margin="28,0,0,0"
                 Text="{x:Static res:Strings.Dialog_Export_Transparent_Note}" />
    </StackPanel>
  </StackPanel>
</UserControl>
