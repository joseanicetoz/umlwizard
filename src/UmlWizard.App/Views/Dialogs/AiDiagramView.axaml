<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:UmlWizard.App.Resources"
             xmlns:dvm="using:UmlWizard.App.ViewModels.Dialogs"
             x:Class="UmlWizard.App.Views.Dialogs.AiDiagramView"
             x:DataType="dvm:AiDiagramViewModel"
             Width="560">
  <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,10,Auto,10,Auto">
    <TextBlock Classes="caption" Text="{x:Static res:Strings.Dialog_AiDiagram_Description}" VerticalAlignment="Top" Margin="0,6,0,0" />
    <TextBox x:Name="DescriptionBox" Grid.Column="1" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="150"
             Watermark="{x:Static res:Strings.Dialog_AiDiagram_Description_Example}" />
    <TextBlock Classes="caption" Grid.Row="2" Text="{x:Static res:Strings.Label_Type}" VerticalAlignment="Center" />
    <ComboBox x:Name="TypeBox" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" />
    <TextBlock Grid.Row="4" Grid.Column="1" Classes="caption" TextWrapping="Wrap" Text="{Binding ServiceNote}" />
  </Grid>
</UserControl>
