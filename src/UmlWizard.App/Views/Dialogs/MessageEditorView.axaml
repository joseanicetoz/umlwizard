<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:UmlWizard.App.Resources"
             xmlns:dvm="using:UmlWizard.App.ViewModels.Dialogs"
             x:Class="UmlWizard.App.Views.Dialogs.MessageEditorView"
             x:DataType="dvm:MessageEditorViewModel"
             Width="420">
  <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,10,Auto,10,Auto,10,Auto">
    <TextBlock Classes="caption" Text="{x:Static res:Strings.Label_Text}" VerticalAlignment="Center" />
    <TextBox Grid.Column="1" Text="{Binding Text}" Watermark="{x:Static res:Strings.Dialog_EditMessage_Text_Hint}" />
    <TextBlock Classes="caption" Grid.Row="2" Text="{x:Static res:Strings.Label_Kind}" VerticalAlignment="Center" />
    <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
              ItemsSource="{x:Static dvm:EnumValues.MessageKinds}" SelectedItem="{Binding Kind}" />
    <TextBlock Classes="caption" Grid.Row="4" Text="{x:Static res:Strings.Dialog_EditMessage_From}" VerticalAlignment="Center" />
    <ComboBox Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch"
              ItemsSource="{Binding Lifelines}" SelectedItem="{Binding Source}" />
    <TextBlock Classes="caption" Grid.Row="6" Text="{x:Static res:Strings.Dialog_EditMessage_To}" VerticalAlignment="Center" />
    <ComboBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch"
              ItemsSource="{Binding Lifelines}" SelectedItem="{Binding Target}" />
  </Grid>
</UserControl>
