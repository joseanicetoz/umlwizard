<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:UmlWizard.App.Resources"
             xmlns:dvm="using:UmlWizard.App.ViewModels.Dialogs"
             xmlns:controls="using:UmlWizard.App.Controls"
             x:Class="UmlWizard.App.Views.Dialogs.ShapeEditorView"
             x:DataType="dvm:ShapeEditorViewModel"
             Width="460">
  <UserControl.Styles>
    <Style Selector="Border.defaultSwatch">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="14">
    <!-- Fill (shapes only) -->
    <StackPanel Spacing="6" IsVisible="{Binding HasFill}">
      <TextBlock Text="{x:Static res:Strings.Dialog_Shape_Fill}" Classes="section" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox x:Name="DefaultFillBox" Content="{x:Static res:Strings.Dialog_Shape_DefaultFill}" IsChecked="{Binding UseDefaultFill}" />
        <Border Classes="defaultSwatch" Background="{Binding DefaultFillBrush}" IsVisible="{Binding !HasNoDefaultFill}"
                ToolTip.Tip="{x:Static res:Strings.Dialog_Shape_DefaultColor_Tip}" />
        <TextBlock Text="{x:Static res:Strings.Dialog_Shape_None}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding HasNoDefaultFill}" />
      </StackPanel>
      <!-- The swatch opens the colour picker; the colour can also be typed -->
      <controls:ColorBox x:Name="FillColor" Text="{Binding FillHex}" EditCommand="{Binding EditFillCommand}" />
    </StackPanel>

    <!-- Border, or the line of a connector -->
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding BorderHeading}" Classes="section" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox x:Name="DefaultBorderBox" Content="{x:Static res:Strings.Dialog_Shape_DefaultBorder}" IsChecked="{Binding UseDefaultBorder}" />
        <Border Classes="defaultSwatch" Background="{Binding DefaultBorderBrush}" IsVisible="{Binding !HasNoDefaultBorder}"
                ToolTip.Tip="{x:Static res:Strings.Dialog_Shape_DefaultColor_Tip}" />
        <TextBlock Text="{x:Static res:Strings.Dialog_Shape_None}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding HasNoDefaultBorder}" />
      </StackPanel>
      <Grid ColumnDefinitions="Auto,24,Auto,8,Auto">
        <controls:ColorBox x:Name="BorderColor" Text="{Binding BorderHex}" EditCommand="{Binding EditBorderCommand}" />
        <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Dialog_Shape_Thickness}" Classes="caption" VerticalAlignment="Center" />
        <NumericUpDown x:Name="BorderWidthBox" Grid.Column="4" Value="{Binding BorderWidth}" Minimum="{Binding MinBorderWidth}" Maximum="{Binding MaxBorderWidth}"
                       Increment="0.5" FormatString="0.0#" Width="120" />
      </Grid>
    </StackPanel>

    <!-- Preview, on the diagram's background -->
    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Background="{DynamicResource DiagramBackgroundBrush}" Height="96" Padding="16">
      <Panel>
        <Border Width="180" Background="{Binding PreviewFill}" BorderBrush="{Binding PreviewBorder}" BorderThickness="{Binding PreviewThickness}" IsVisible="{Binding !IsLine}">
          <TextBlock Text="{x:Static res:Strings.Dialog_Shape_Sample}" Foreground="{Binding PreviewText}" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="LinePreview" Width="220" Height="{Binding PreviewLineHeight}" Background="{Binding PreviewBorder}" VerticalAlignment="Center" IsVisible="{Binding IsLine}" />
      </Panel>
    </Border>

    <Button Content="{x:Static res:Strings.Dialog_Shape_Reset}" Command="{Binding ResetToDefaultsCommand}" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
