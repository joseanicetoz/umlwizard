          },
          {
            "sourceId": "ll-orders001",
            "targetId": "ll-orders001",
            "text": "validate()",
            "kind": "synchronous",
            "id": "msg000000003"
          },
          {
            "sourceId": "ll-orders001",
            "targetId": "ll-payment01",
            "text": "charge(total)",
            "kind": "synchronous",
            "id": "msg000000004"
          },
          {
            "sourceId": "ll-payment01",
            "targetId": "ll-orders001",
            "text": "receipt",
            "kind": "reply",
            "id": "msg000000005"
          },
          {
            "sourceId": "ll-orders001",
            "targetId": "ll-shop00001",
            "text": "order",
            "kind": "reply",
            "id": "msg000000006"
          },
          {
            "sourceId": "ll-shop00001",
            "targetId": "ll-customer1",
            "text": "confirmation",
            "kind": "asynchronous",
            "id": "msg000000007"
          }
