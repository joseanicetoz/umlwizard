          },
          {
            "name": "",
            "type": "PaymentGateway",
            "kind": "object",
            "id": "ll-payment01"
          }
        ],
        "messages": [
          {
            "sourceId": "ll-customer1",
            "targetId": "ll-shop00001",
            "text": "checkout(cart)",
            "kind": "synchronous",
